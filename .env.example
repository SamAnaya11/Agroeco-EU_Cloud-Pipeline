# =====================================================================
# .env.example  ->  copia este archivo como ".env" y rellena los valores.
# El archivo .env está en .gitignore: NUNCA se sube a GitHub.
#
# Solo hace falta para ejecutar el pipeline completo desde tu ordenador
# (python -m src.pipeline). En Azure estas variables ya están configuradas
# en la Function App (las crea el Bicep).
#
# Cómo obtener los valores (ver README, sección "Ejecutar en local"):
#   az storage account show-connection-string -g rg-agroeco-dev -n <storage> --query connectionString -o tsv
# =====================================================================

# Cadena de conexión de la Storage Account (contenedores raw y processed)
ALMACENAMIENTO_DATOS=DefaultEndpointsProtocol=https;AccountName=<cuenta>;AccountKey=<clave>;EndpointSuffix=core.windows.net

# Cadena de conexión de Azure SQL Database
# (recuerda añadir tu IP al firewall del servidor SQL: parámetro ipCliente del Bicep)
# (mssql-python NO admite "Connection Timeout" aquí; el tiempo de espera está en src/carga_sql.py)
SQL_CADENA_CONEXION=Server=tcp:<servidor>.database.windows.net,1433;Database=sqldb-agroeco;UID=<usuario>;PWD=<contraseña>;Encrypt=yes;TrustServerCertificate=no;
